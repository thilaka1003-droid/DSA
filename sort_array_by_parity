class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {
        int j=nums.size()-1;
        int k=0;
        while(k<j){
            if(nums[k]%2!=0 && nums[j]%2==0){
                swap(nums[k],nums[j]);
                k++;
                j--;
            }
            else if(nums[k]%2==0) {
                k++;
            }
            else{
                j--;

            }
        }
        return nums;
        
    }
};
